# --- DATABASE CONFIG ---
# POSTGRES

POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=travel_db
POSTGRES_PORT=5432
# AI / RAG (dev and rag-demo). Keep real keys in ignored local .env files.
GEMINI_API_KEY=

RAG_INTENT_MODEL=gemini-3.5-flash
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_AI_DEADLINE_MILLIS=60000
RAG_AI_CALL_TIMEOUT_MILLIS=30000
RAG_AI_RETRY_BACKOFF_MILLIS=500
RAG_WEATHER_WAIT_MILLIS=2000

# Generate random 256-bit (64 hex chars) secrets locally, e.g. openssl rand -hex 32
JWT_SECRET_KEY=
JWT_REFRESH_KEY=
# Secondary database; URL-encode credentials inside MONGODB_URI. Do not use root for backend.
MONGODB_ENABLED=true
MONGO_PORT=27018
MONGO_ROOT_USER=wego_root
MONGO_ROOT_PASSWORD=replace_with_private_root_password
MONGO_APP_USER=wego_telemetry
MONGO_APP_PASSWORD=replace_with_private_app_password
MONGODB_DATABASE=wego_telemetry
MONGODB_URI=mongodb://wego_telemetry:replace_with_private_app_password@127.0.0.1:27018/wego_telemetry?authSource=wego_telemetry
AI_TELEMETRY_RETENTION_DAYS=90

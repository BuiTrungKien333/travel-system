  "item": [
    {
      "name": "1. Weather Module",
      "description": "Các API truy vấn thời tiết thực tế và dự báo theo tọa độ GPS",
      "item": [
        {
          "name": "1.1 GET Current Weather (Đà Nẵng)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/weather/current?latitude=16.0592&longitude=108.2464",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "weather", "current"],
              "query": [
                { "key": "latitude", "value": "16.0592", "description": "Vĩ độ Đà Nẵng" },
                { "key": "longitude", "value": "108.2464", "description": "Kinh độ Đà Nẵng" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Current weather data is returned correctly', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data).to.have.property('temperature');",
                  "    pm.expect(res.data).to.have.property('apparentTemperature');",
                  "    pm.expect(res.data).to.have.property('condition');",
                  "    pm.expect(res.data).to.have.property('outdoorRiskLevel');",
                  "    pm.expect(['SAFE', 'MODERATE', 'HIGH', 'EXTREME']).to.include(res.data.outdoorRiskLevel);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 GET Weather Forecast 3 Days (Đà Nẵng)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/weather/forecast?latitude=16.0592&longitude=108.2464&startDate=2026-10-01&endDate=2026-10-03",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "weather", "forecast"],
              "query": [
                { "key": "latitude", "value": "16.0592" },
                { "key": "longitude", "value": "108.2464" },
                { "key": "startDate", "value": "2026-10-01" },
                { "key": "endDate", "value": "2026-10-03" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Weather forecast contains daily and hourly records', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data.dailyForecasts).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(res.data.dailyForecasts[0]).to.have.property('date');",
                  "    pm.expect(res.data.dailyForecasts[0]).to.have.property('weatherCondition');",
                  "    pm.expect(res.data.dailyForecasts[0]).to.have.property('tempMax');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 GET Current Weather (Hà Nội - Hoàn Kiếm)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/weather/current?latitude=21.0285&longitude=105.8542",
              "host": ["{{baseUrl}}"],

# Server Port
SERVER_PORT=18081

# Database Configuration
POSTGRES_PORT=5432
POSTGRES_DB=travel_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# JWT Secrets (At least 256-bit / 32 characters or Base64 encoded)
JWT_SECRET_KEY=9a4f2c8d7e1b5a3f6c8e0d2b4a6f8c1d3e5a7b9c1d3e5f7a9b1c3d5e7f9a1b3c
JWT_REFRESH_KEY=7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c

# OpenAPI Swagger URL
OPENAPI_DEV_URL=http://localhost:8080

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email: keep disabled until SMTP and the sender are configured.
# Resend SMTP: smtp.resend.com / 587 / username resend / password = API key.
# Gmail SMTP: smtp.gmail.com / 587 / username your Gmail address / password = App Password.
# Local Mailpit: localhost / 1025 / auth false / STARTTLS false (dev only).
AUTH_EMAIL_ENABLED=false
AUTH_EMAIL_FROM=
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_SSL_ENABLED=false

# Web development frontend runs at localhost:8082; backend API uses a separate port.
# For an installed native development build, override these with app.json's scheme URLs.
# Production: trusted HTTPS domain, with Universal/App Links configured if opening the app.
AUTH_VERIFY_EMAIL_URL=http://localhost:8082/verify-email
AUTH_RESET_PASSWORD_URL=http://localhost:8082/reset-password
AUTH_VERIFICATION_TTL=24h
AUTH_RESET_TTL=30m
AUTH_RESEND_COOLDOWN=60s

# Google sign-in. Web OAuth client ID is shared by Android/iOS and backend audience verification.
GOOGLE_AUTH_ENABLED=false
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CHALLENGE_TTL=5m
GOOGLE_LINK_TTL=10m
# Only needed for Google accounts whose email is not hosted by Gmail/Workspace.

# Private Geoapify key used by backend Geocoding and Routing APIs.
# Restrict the key to Geocoding API and Routing API in Geoapify MyProjects.
GEOAPIFY_API_KEY=
## Mapbox Directions for saved itineraries, plus optional temporary Geocoding v6.
MAPBOX_GEOCODING_ENABLED=false
MAPBOX_ACCESS_TOKEN=
MAPBOX_TIMEOUT_SECONDS=5
MAPS_PROVIDER_TIMEOUT_SECONDS=10

# Weather is provided by Open-Meteo by default and does not need an API key.
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# AI provider credentials are supplied through environment variables, never source defaults.
GEMINI_API_KEY=

# Cached integration health checks (default: every 30 minutes after startup).
INTEGRATION_HEALTH_INTERVAL_MS=1800000
INTEGRATION_HEALTH_INITIAL_DELAY_MS=15000

GOOGLE_LINK_URL=http://localhost:8082/google-link

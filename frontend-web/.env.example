# =====================
# Environment Variables — Tripzy Frontend
# Copy this file to .env.local and fill in values
# =====================

# Backend REST API base URL (Spring Boot)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1


# Google Maps JavaScript API Key (for MapView component)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Places API Key (for Place Search / Autocomplete)
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# Public browser token for the Mapbox display layer
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

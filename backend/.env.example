# Server Port
SERVER_PORT=8080

# Database Configuration
POSTGRES_PORT=5432
POSTGRES_DB=travel_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# JWT Secrets (At least 256-bit / 32 characters or Base64 encoded)
JWT_SECRET_KEY=9a4f2c8d7e1b5a3f6c8e0d2b4a6f8c1d3e5a7b9c1d3e5f7a9b1c3d5e7f9a1b3c
JWT_REFRESH_KEY=7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c

# OpenAPI Swagger URL
OPENAPI_DEV_URL=http://localhost:8080

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email: keep disabled until SMTP and the sender are configured.
# Resend SMTP: smtp.resend.com / 587 / username resend / password = API key.
# Gmail SMTP: smtp.gmail.com / 587 / username your Gmail address / password = App Password.
# Local Mailpit: localhost / 1025 / auth false / STARTTLS false (dev only).
AUTH_EMAIL_ENABLED=false
AUTH_EMAIL_FROM=
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_SSL_ENABLED=false

# Development build installed with app.json's scheme; Expo Go uses its exp:// URL instead.
# Web preview: http://localhost:8081/verify-email and /reset-password.
# Production: trusted HTTPS domain, with Universal/App Links configured if opening the app.
AUTH_VERIFY_EMAIL_URL=travelplannermobileui://verify-email
AUTH_RESET_PASSWORD_URL=travelplannermobileui://reset-password
AUTH_VERIFICATION_TTL=24h
AUTH_RESET_TTL=30m
AUTH_RESEND_COOLDOWN=60s

{
  "info": {
    "_postman_id": "a2777636-a24f-42a7-853f-ec06e77f914e",
    "name": "Travel System - Trip & Trip Place Local CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local-only CRUD sequence for authenticated Trip and TripPlace APIs. Set accessToken locally and run in order against a disposable local/test backend. Uses no auth registration/email requests. Creates one master Place which is intentionally preserved by cleanup. Docs: docs/TRIP_PLACE_API.md."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "tripId",
      "value": "",
      "type": "string"
    },
    {
      "key": "placeId",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"01 Create Trip\") {",
          "  if (!pm.variables.get(\"accessToken\")) throw new Error(\"Set accessToken locally before running the collection.\");",
          "  const start = new Date(); start.setUTCDate(start.getUTCDate() + 7);",
          "  const end = new Date(start); end.setUTCDate(end.getUTCDate() + 2);",
          "  pm.collectionVariables.set(\"tripStartDate\", start.toISOString().slice(0, 10));",
          "  pm.collectionVariables.set(\"tripEndDate\", end.toISOString().slice(0, 10));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Create Trip",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/trips",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trips"
          ]
        },
        "description": "Creates a new Trip owned by the bearer-token user. All following requests use the captured internal tripId.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman local CRUD {{$timestamp}}\",\n  \"destination\": \"Đà Nẵng\",\n  \"startDate\": \"{{tripStartDate}}\",\n  \"endDate\": \"{{tripEndDate}}\",\n  \"transportation\": \"Car\",\n  \"preferences\": [\n    \"Nature\",\n    \"Food\"\n  ],\n  \"budget\": 3000000,\n  \"constraints\": \"Không đi quá sớm\",\n  \"description\": \"Temporary local API sample\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"Success wrapper\", () => { pm.expect(body.success).to.eql(true); pm.expect(body).to.have.property(\"data\"); });",
              "const data = body.data;",
              "pm.test(\"Trip defaults and counters\", () => { pm.expect(data.status).to.eql(\"PLANNING\"); pm.expect(data.placeCount).to.eql(0); pm.expect(data.visitedCount).to.eql(0); pm.expect(data.memoryCount).to.eql(0); pm.expect(data.userId).to.be.a(\"string\"); });",
              "pm.collectionVariables.set(\"tripId\", data.id);",
              "pm.collectionVariables.set(\"tripName\", data.name);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 List own Trips",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/trips",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trips"
          ]
        },
        "description": "List response is an array in ApiResponse.data."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Success wrapper\", () => { pm.expect(body.success).to.eql(true); pm.expect(body).to.have.property(\"data\"); });",
              "const data = body.data;",
              "pm.test(\"Array includes created Trip\", () => { pm.expect(data).to.be.an(\"array\"); pm.expect(data.some(trip => trip.id === pm.collectionVariables.get(\"tripId\"))).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Read Trip",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/trips/{{tripId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trips",
            "{{tripId}}"
          ]
        },
        "description": "Reads the owned Trip and summary counters."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Success wrapper\", () => { pm.expect(body.success).to.eql(true); pm.expect(body).to.have.property(\"data\"); });",
              "const data = body.data;",
              "pm.test(\"Read correct Trip\", () => { pm.expect(data.id).to.eql(pm.collectionVariables.get(\"tripId\")); pm.expect(data.name).to.eql(pm.collectionVariables.get(\"tripName\")); pm.expect(data.preferences).to.eql([\"Nature\", \"Food\"]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Partial update Trip",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/trips/{{tripId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trips",
            "{{tripId}}"
          ]
        },
        "description": "Missing/null fields retain previous values; READY is supported.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Đã cập nhật qua Postman\",\n  \"status\": \"READY\",\n  \"name\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Success wrapper\", () => { pm.expect(body.success).to.eql(true); pm.expect(body).to.have.property(\"data\"); });",
              "const data = body.data;",
              "pm.test(\"Partial PUT retains null/missing fields\", () => { pm.expect(data.name).to.eql(pm.collectionVariables.get(\"tripName\")); pm.expect(data.destination).to.eql(\"Đà Nẵng\"); pm.expect(data.status).to.eql(\"READY\"); pm.expect(data.description).to.eql(\"Đã cập nhật qua Postman\"); });"
            ]
          }
        }
      ]
    },

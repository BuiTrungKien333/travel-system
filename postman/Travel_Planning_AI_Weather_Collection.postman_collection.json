    {
      "name": "2. TSP Route Optimization (Held-Karp)",
      "description": "Tối ưu hóa thứ tự ghé thăm điểm đến du lịch bằng thuật toán quy hoạch động Held-Karp",
      "item": [
        {
          "name": "2.1 POST Optimize Route - Round Trip (Đà Nẵng)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startPlaceId\": \"11111111-1111-1111-1111-111111111111\",\n  \"isRoundTrip\": true,\n  \"locations\": [\n    {\n      \"id\": \"11111111-1111-1111-1111-111111111111\",\n      \"name\": \"Khách sạn Novotel Đà Nẵng\",\n      \"latitude\": 16.0778,\n      \"longitude\": 108.2238,\n      \"placeType\": \"INDOOR\",\n      \"openingTime\": \"00:00:00\",\n      \"closingTime\": \"23:59:59\",\n      \"durationMinutes\": 30\n    },\n    {\n      \"id\": \"22222222-2222-2222-2222-222222222222\",\n      \"name\": \"Bảo tàng Điêu khắc Chăm\",\n      \"latitude\": 16.0592,\n      \"longitude\": 108.2272,\n      \"placeType\": \"INDOOR\",\n      \"openingTime\": \"07:30:00\",\n      \"closingTime\": \"17:00:00\",\n      \"durationMinutes\": 60\n    },\n    {\n      \"id\": \"33333333-3333-3333-3333-333333333333\",\n      \"name\": \"Bán đảo Sơn Trà & Chùa Linh Ứng\",\n      \"latitude\": 16.1000,\n      \"longitude\": 108.2778,\n      \"placeType\": \"OUTDOOR\",\n      \"openingTime\": \"06:00:00\",\n      \"closingTime\": \"18:00:00\",\n      \"durationMinutes\": 90\n    },\n    {\n      \"id\": \"44444444-4444-4444-4444-444444444444\",\n      \"name\": \"Cầu Rồng Đà Nẵng\",\n      \"latitude\": 16.0610,\n      \"longitude\": 108.2272,\n      \"placeType\": \"OUTDOOR\",\n      \"openingTime\": \"00:00:00\",\n      \"closingTime\": \"23:59:59\",\n      \"durationMinutes\": 45\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/planning/tsp/optimize",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "planning", "tsp", "optimize"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('TSP route is optimized and returns round-trip sequence', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data.isRoundTrip).to.be.true;",
                  "    pm.expect(res.data.orderedPlaces).to.have.lengthOf(5);",
                  "    pm.expect(res.data.orderedPlaces[0].id).to.eql('11111111-1111-1111-1111-111111111111');",
                  "    pm.expect(res.data.orderedPlaces[4].id).to.eql('11111111-1111-1111-1111-111111111111');",
                  "    pm.expect(res.data.totalDistanceKm).to.be.greaterThan(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 POST Optimize Route - One Way (Điểm bắt đầu chỉ định)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startPlaceId\": \"11111111-1111-1111-1111-111111111111\",\n  \"isRoundTrip\": false,\n  \"locations\": [\n    {\n      \"id\": \"11111111-1111-1111-1111-111111111111\",\n      \"name\": \"Khách sạn Novotel Đà Nẵng\",\n      \"latitude\": 16.0778,\n      \"longitude\": 108.2238\n    },\n    {\n      \"id\": \"22222222-2222-2222-2222-222222222222\",\n      \"name\": \"Bảo tàng Điêu khắc Chăm\",\n      \"latitude\": 16.0592,\n      \"longitude\": 108.2272\n    },\n    {\n      \"id\": \"33333333-3333-3333-3333-333333333333\",\n      \"name\": \"Cầu Rồng Đà Nẵng\",\n      \"latitude\": 16.0610,\n      \"longitude\": 108.2272\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/planning/tsp/optimize",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "planning", "tsp", "optimize"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('One-way route has exact N places without returning to start', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data.isRoundTrip).to.be.false;",
                  "    pm.expect(res.data.orderedPlaces).to.have.lengthOf(3);",
                  "    pm.expect(res.data.orderedPlaces[0].id).to.eql('11111111-1111-1111-1111-111111111111');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 POST Optimize Route - Validation Error (< 2 locations)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isRoundTrip\": false,\n  \"locations\": [\n    {\n      \"id\": \"11111111-1111-1111-1111-111111111111\",\n      \"name\": \"Chỉ có 1 điểm\",\n      \"latitude\": 16.0778,\n      \"longitude\": 108.2238\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/planning/tsp/optimize",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "planning", "tsp", "optimize"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Validation error returned in error payload', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Deterministic Rule Evaluator",
      "description": "Bộ thẩm định các quy tắc xác định (Giờ mở cửa, thời tiết ngoài trời, tính khả thi di chuyển)",
      "item": [
        {
          "name": "3.1 POST Evaluate Schedule - Clean (AI Trigger = False)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"placeId\": \"11111111-1111-1111-1111-111111111111\",\n      \"placeName\": \"Bảo tàng Điêu khắc Chăm\",\n      \"latitude\": 16.0592,\n      \"longitude\": 108.2272,\n      \"placeType\": \"INDOOR\",\n      \"openingTime\": \"07:30:00\",\n      \"closingTime\": \"17:00:00\",\n      \"arrivalTime\": \"2026-10-01T09:00:00\",\n      \"durationMinutes\": 60,\n      \"transitDistanceKmFromPrev\": 2.0,\n      \"transitMinutesFromPrev\": 15\n    },\n    {\n      \"placeId\": \"22222222-2222-2222-2222-222222222222\",\n      \"placeName\": \"Nhà hàng Bếp Trang\",\n      \"latitude\": 16.0650,\n      \"longitude\": 108.2250,\n      \"placeType\": \"INDOOR\",\n      \"openingTime\": \"10:00:00\",\n      \"closingTime\": \"21:00:00\",\n      \"arrivalTime\": \"2026-10-01T11:00:00\",\n      \"durationMinutes\": 60,\n      \"transitDistanceKmFromPrev\": 1.2,\n      \"transitMinutesFromPrev\": 10\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/planning/rules/evaluate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "planning", "rules", "evaluate"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Clean schedule does NOT trigger AI (shouldTriggerAi is false)', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data.shouldTriggerAi).to.be.false;",
                  "    pm.expect(res.data.hasCriticalIssues).to.be.false;",
                  "    pm.expect(res.data.detectedIssues).to.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 POST Evaluate Schedule - Opening Hours Conflict",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"placeId\": \"11111111-1111-1111-1111-111111111111\",\n      \"placeName\": \"Bảo tàng Điêu khắc Chăm (Đóng cửa 17:00)\",\n      \"latitude\": 16.0592,\n      \"longitude\": 108.2272,\n      \"placeType\": \"INDOOR\",\n      \"openingTime\": \"07:30:00\",\n      \"closingTime\": \"17:00:00\",\n      \"arrivalTime\": \"2026-10-01T18:30:00\",\n      \"durationMinutes\": 60,\n      \"transitDistanceKmFromPrev\": 0.0,\n      \"transitMinutesFromPrev\": 0\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/planning/rules/evaluate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "planning", "rules", "evaluate"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Detects OPENING_HOURS violation and flags shouldTriggerAi = true', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data.shouldTriggerAi).to.be.true;",
                  "    pm.expect(res.data.detectedIssues).to.be.an('array').that.is.not.empty;",
                  "    var issue = res.data.detectedIssues.find(i => i.category === 'OPENING_HOURS');",
                  "    pm.expect(issue).to.not.be.undefined;",
                  "    pm.expect(issue.severity).to.eql('HIGH');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 POST Evaluate Schedule - Impossible Transit Time",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"placeId\": \"11111111-1111-1111-1111-111111111111\",\n      \"placeName\": \"Trung tâm Đà Nẵng\",\n      \"latitude\": 16.0592,\n      \"longitude\": 108.2272,\n      \"placeType\": \"INDOOR\",\n      \"arrivalTime\": \"2026-10-01T08:00:00\",\n      \"durationMinutes\": 60,\n      \"transitDistanceKmFromPrev\": 0.0,\n      \"transitMinutesFromPrev\": 0\n    },\n    {\n      \"placeId\": \"22222222-2222-2222-2222-222222222222\",\n      \"placeName\": \"Bà Nà Hills (Cách 35km nhưng chỉ cho 5 phút di chuyển)\",\n      \"latitude\": 15.9967,\n      \"longitude\": 107.9877,\n      \"placeType\": \"OUTDOOR\",\n      \"arrivalTime\": \"2026-10-01T09:05:00\",\n      \"durationMinutes\": 180,\n      \"transitDistanceKmFromPrev\": 35.0,\n      \"transitMinutesFromPrev\": 5\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/planning/rules/evaluate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "planning", "rules", "evaluate"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Detects TRANSIT_TIME issue and requires AI intervention', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data.shouldTriggerAi).to.be.true;",
                  "    var issue = res.data.detectedIssues.find(i => i.category === 'TRANSIT_TIME');",
                  "    pm.expect(issue).to.not.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. AI Travel Copilot Pipeline (Gemini 3.8 Flash)",
      "description": "Toàn bộ chu trình điều phối: Held-Karp + Weather + Rule Evaluator + Gemini 3.8 Flash Copilot (HITL)",
      "item": [
        {
          "name": "4.1 POST Optimize & Audit - Clean Route (AI Silent - 0 Token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"Đà Nẵng\",\n  \"tripDate\": \"2026-10-01\",\n  \"startTime\": \"08:30:00\",\n  \"isRoundTrip\": false,\n  \"userNotes\": \"Chuyến đi nhẹ nhàng cuối tuần\",\n  \"locations\": [\n    {\n      \"id\": \"11111111-1111-1111-1111-111111111111\",\n      \"name\": \"Bảo tàng Điêu khắc Chăm\",\n      \"latitude\": 16.0592,\n      \"longitude\": 108.2272,\n      \"placeType\": \"INDOOR\",\n      \"openingTime\": \"07:30:00\",\n      \"closingTime\": \"17:00:00\",\n      \"durationMinutes\": 60\n    },\n    {\n      \"id\": \"22222222-2222-2222-2222-222222222222\",\n      \"name\": \"Cầu Rồng Đà Nẵng\",\n      \"latitude\": 16.0610,\n      \"longitude\": 108.2272,\n      \"placeType\": \"OUTDOOR\",\n      \"openingTime\": \"00:00:00\",\n      \"closingTime\": \"23:59:59\",\n      \"durationMinutes\": 45\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/planning/itinerary/optimize-and-audit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "planning", "itinerary", "optimize-and-audit"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('AI Copilot stays SILENT when itinerary is flawless (0 token)', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data.aiTriggered).to.be.false;",
                  "    pm.expect(res.data.copilotAnalysis).to.be.null;",
                  "    pm.expect(res.data.optimizedSchedule).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 POST Optimize & Audit - Conflicted Route (Gemini 3.8 Triggered)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"Đà Nẵng\",\n  \"tripDate\": \"2026-10-01\",\n  \"startTime\": \"16:45:00\",\n  \"isRoundTrip\": false,\n  \"userNotes\": \"Chuyến tham quan chiều tối\",\n  \"locations\": [\n    {\n      \"id\": \"11111111-1111-1111-1111-111111111111\",\n      \"name\": \"Bảo tàng Điêu khắc Chăm (Đóng cửa 17:00)\",\n      \"latitude\": 16.0592,\n      \"longitude\": 108.2272,\n      \"placeType\": \"INDOOR\",\n      \"openingTime\": \"07:30:00\",\n      \"closingTime\": \"17:00:00\",\n      \"durationMinutes\": 60\n    },\n    {\n      \"id\": \"22222222-2222-2222-2222-222222222222\",\n      \"name\": \"Bán đảo Sơn Trà\",\n      \"latitude\": 16.1000,\n      \"longitude\": 108.2778,\n      \"placeType\": \"OUTDOOR\",\n      \"openingTime\": \"06:00:00\",\n      \"closingTime\": \"18:00:00\",\n      \"durationMinutes\": 90\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/planning/itinerary/optimize-and-audit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "planning", "itinerary", "optimize-and-audit"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('AI Copilot triggers and returns recommendation cards', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data.aiTriggered).to.be.true;",
                  "    pm.expect(res.data.copilotAnalysis).to.not.be.null;",
                  "    pm.expect(res.data.copilotAnalysis.recommendationCards).to.be.an('array');",
                  "    if (res.data.copilotAnalysis.recommendationCards.length > 0) {",
                  "        var firstCard = res.data.copilotAnalysis.recommendationCards[0];",
                  "        pm.environment.set('copilotCardId', firstCard.cardId);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.3 POST HITL 1-Click Action - SWAP_PLACES",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
